# 创建示例文件（不含敏感信息）
cat > .env.example << EOF
VECTOR_DB_TYPE=faiss # 向量数据库类型，可选值：faiss, milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
FAISS_INDEX_PATH=./data/faiss_index
EMBEDDING_MODEL=your-embedding-model-here # 词嵌入模型的名称
EMBEDDING_BASE_URL=your-embedding-api-base-url-here # 词嵌入模型的API地址
EMBEDDING_API_KEY=your-api-key-here  # 用户需要自己填写
DATA_DIR=./data
MAX_RESULTS=5
EOF